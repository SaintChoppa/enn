{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enn",
  "version": "0.1.0",
  "identifier": "com.enn.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Enn",
        "width": 1120,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
